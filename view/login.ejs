<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>로그인 - 재고관리시스템</title>
    <style>
    :root{
        --bg-color:#b9c1cc;
        --card-bg:#f2f2f2;
        --text-main:#111827;
        --text-sub:#6b7280;
        --border:#e5e7eb;
        --primary:#020617;
        --radius:14px;
    }

    *{
        box-sizing:border-box;
    }

    body{
        margin:0;
        font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial;
        background:var(--bg-color);
    }

    /* 전체 가운데 정렬 */
    .main-container{
        width:100vw;
        height:100vh;
        display:flex;
        justify-content:center;
        align-items:center;
    }

    /* 카드 */
    .login-container{
        width:420px;
        background:var(--card-bg);
        border-radius:var(--radius);
        padding:36px;
        text-align:center;
        box-shadow:0 10px 30px rgba(0,0,0,0.15);
    }

    /* 아이콘 */
    .brand{
        width:50px;
        height:50px;
        background:#2563eb;
        border-radius:12px;
        display:flex;
        align-items:center;
        justify-content:center;
        margin:0 auto 18px auto;
        color:white;
        font-size:20px;
    }

    /* 제목 */
    .login-title{
        font-size:24px;
        font-weight:700;
        margin:0 0 10px 0;
    }

    /* 설명 */
    .login-subtitle{
        font-size:14px;
        color:var(--text-sub);
        margin-bottom:24px;
    }

    /* 입력 그룹 */
    .input-group{
        text-align:left;
        margin-bottom:16px;
    }

    /* 라벨 */
    .input-label{
        font-size:13px;
        font-weight:600;
        margin-bottom:6px;
        display:block;
    }

    /* 입력창 */
    .input-control{
        width:100%;
        padding:12px;
        border-radius:8px;
        border:1px solid var(--border);
        background:#e5e7eb;
        font-size:14px;
    }

    /* 버튼 */
    .login-button{
        width:100%;
        height:44px;
        margin-top:14px;
        border:none;
        border-radius:8px;
        background:var(--primary);
        color:white;
        font-size:15px;
        font-weight:600;
        cursor:pointer;
    }

    .login-button:hover{
        opacity:0.9;
    }

    /* 하단 */
    .footer{
        margin-top:16px;
        font-size:13px;
        color:var(--text-sub);
    }

    .footer a{
        color:#2563eb;
        text-decoration:none;
        font-weight:600;
    }
    </style>
</head>
<body>
    <div class="main-container">
        <div class="login-container">
            <div class="login-header">
                <div class="brand">HW</div>
                <h1 class="login-title">재고 관리 시스템</h1>
                <p class="login-subtitle">계정에 로그인하여 서비스를 이용하세요</p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="error-message">
                    <%= error %>
                </div>
            <% } %>

            <% if (typeof success !== 'undefined' && success) { %>
                <div class="success-message">
                    <%= success %>
                </div>
            <% } %>

            <form method="POST" action="/auth/api/login">
                <div class="input-group">
                    <label for="id" class="input-label">아이디</label>
                    <input type="text" id="id" name="id" class="input-control" placeholder="아이디를 입력하세요" required>
                </div>

                <div class="input-group">
                    <label for="password" class="input-label">비밀번호</label>
                    <input type="password" id="password" name="password" class="input-control" placeholder="비밀번호를 입력하세요" required>
                </div>

                <div class="actions">
                    <label class="remember"><input type="checkbox" id="remember" name="remember"> 로그인 유지</label>
                    <a class="forgot" href="#" onclick="event.preventDefault(); alert('비밀번호 찾기 기능은 준비 중입니다.');">비밀번호를 잊으셨나요?</a>
                </div>

                <button type="submit" class="login-button">로그인</button>
            </form>

            <a href="/auth/join" class="signup-button">회원가입</a>

            <div class="footer">© <%= new Date().getFullYear() %> 재고 관리 시스템</div>
        </div>
    </div>
</body>
</html>