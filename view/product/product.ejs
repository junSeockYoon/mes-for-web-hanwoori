<%- include('../header')  %>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/product.css">
    <script src=""></script>
</head>
    <div class="prodContainer">
        <div class="prodBox">
            <div style="height: 50%;">
                <h3>제품 관리</h3>
                <p>제품과 카테고리를 관리할 수 있습니다</p>
                <div class="prodButton">
                    <a href="" class="btProd">
                        <img src="/images/icons/mainLogo.png" class="btProdLogo">
                        제품 목록 </a>
                    <a href="" class="btCate">카테고리 관리</a>  
                </div>
            </div>
            <div>
                <table>
                    <thead>
                        <tr>
                            <th>제품명</th>
                            <th>카테고리</th>
                            <th>가격</th>
                            <th>재고</th>
                            <th>상태</th>
                            <th>작업</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for(i = 0; i < result.length; i++){ %>
                        <tr>
                            <td><%= result[i].prodName %></td>
                            <td>전자제품</td>
                            <td><%= result[i].price %></td>
                            <td><%= result[i].count %></td>
                            <td>재고충분</td>
                            <td>수정 삭제</td>
                        </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>