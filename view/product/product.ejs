<%- include('../header')  %>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/product.css">
    <!-- <script type="text.javascript" src="/javascripts/product.js"></script> -->
</head>
    <div class="prodContainer">
        <div class="prodBox">
            <div style="height: 50%;">
                <h3>제품 관리</h3>
                <p style=" font-size: 18px; color: #5D5D5D;">제품과 카테고리를 관리할 수 있습니다</p>
                <div class="prodButton">
                    <a href="/product/product" >
                        <div class="btProd on" style="display: flex; align-items: center; justify-content: center;">
                            <img src="/images/icons/mainLogo.png" class="btProdLogo"> 
                            <p style=" font-size: 18px; color: #5D5D5D;">제품목록</p> 
                        </div>
                     </a>
                    <a href="/product/category" >
                        <div class="btCate" style="display: flex; align-items: center; justify-content: center;">
                            <img src="/images/icons/category.png" class="btCateLogo">
                            <p style=" font-size: 18px; color: #5D5D5D;">카테고리관리</p>
                        </div>
                    </a>  
                </div>
            </div>
            <div class="serchContainer">
                <!-- 모달 띄우기 버튼 시작 -->
                <button type="button" id="serchButton">
                    + 제품추가
                </button>
                <!-- 모달 띄우기 버튼 끝 -->
            </div>
            <!-- 모달 창 감싸는 div 시작 -->
            <div id="modalWrap">
                <div id="modalBody">
                    <span id="closeBtn">&times;</span>
                    <p style="font-size: 30px; font-weight: bolder; margin-top: 0px; margin-bottom: 10px;">새 제품 추가</p>
                    <p style=" font-size: 18px; color: #5D5D5D; margin-top: 0px;">새로운 제품 정보를 입력합니다. 완료되면 저장 버튼을 클릭하세요.</p>
                    <div class="newProdct">
                        <form action="/product/saveProduct" method="post">
                            <table>
                                <tr><td colspan="2"><p>제품명 *</p></td></tr>
                                <tr><td colspan="2"><input type="text" placeholder="예: 노트북" style="width: 95%;" name="prodName" id="prodName"></td></tr>
                                <tr><td colspan="2"><p>카테고리 *</p></td></tr>
                                <tr><td colspan="2"><select size="4" name="category">
                                    <option value="electronics" selected>전자제품</option>
                                    <option value="furniture">가구</option>
                                    <option value="officeSupplies">사무용품</option>
                                    <option value="dailySupplies">생활용품</option>
                                </select></td></tr>
                                <tr>
                                    <td><p>가격 (원) *</p></td>
                                    <td><p>재고 수량 *</p></td>
                                </tr>
                                <tr>
                                    <td><input type="text" placeholder="0" style="width: 90%;" name="price" id="price"></td>
                                    <td><input type="text" placeholder="0" style="width: 90%;" name="count" id="count"></td>
                                </tr>
                                <tr><td colspan="2"><p>설명</p></td></tr>
                                <tr><td colspan="2"><textarea name="note" placeholder="제품에 대한 설명을 입력하세요"
                                    row="100" cols="58"></textarea></td></tr>
                            </table>
                            <button type="button">취소</button>
                            <button type="submit">저장</button>
                        </form>
                    </div>
                </div>
            </div>
            <!-- 모달 창 감싸는 div 끝 -->
            <div class="tableBox">
                <table>
                    <thead>
                        <tr>
                            <th>제품명</th>
                            <th>카테고리</th>
                            <th>가격</th>
                            <th>재고</th>
                            <th>상태</th>
                            <th style="text-align: right;">작업</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for(i = 0; i < result.length; i++){ %>
                        <tr>
                            <td><%= result[i].prodName %></td>
                            <td>전자제품</td>
                            <td><%= result[i].price %></td>
                            <td><%= result[i].count %></td>
                            <td>재고충분</td>
                            <td style="text-align: right;">수정 삭제</td>
                        </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>
<script>
const btn = document.getElementById("serchButton");
const modal = document.getElementById("modalWrap");
const closeBtn = document.getElementById("closeBtn");


btn.onclick = function () {
//   alert('hey');
   modal.style.display = "block"; // 버튼을 클릭하면 모달을 보이게 함
};

 closeBtn.onclick = function () {
   modal.style.display = "none"; // 모달을 닫는 버튼(X)을 클릭하면 모달을 숨김
 };

 window.onclick = function (event) {
   if (event.target == modal) {
     modal.style.display = "none"; // 모달 외부를 클릭하면 모달을 숨김
   }
 };
</script>