<%- include('../header')  %>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/category.css">
</head>
    <div class="prodContainer">
        <div class="prodBox">
            <div style="">
                <h3>제품 관리</h3>
                <p style=" font-size: 18px; color: #5D5D5D;">제품과 카테고리를 관리할 수 있습니다</p>
                <div class="prodButton">
                    <a href="/product/product" >
                        <div class="btProd" style="display: flex; align-items: center; justify-content: center;">
                            <img src="/images/icons/mainLogo.png" class="btProdLogo"> 
                            <p style=" font-size: 18px; color: #5D5D5D;">제품목록</p> 
                        </div>
                     </a>
                    <a href="/product/category" >
                        <div class="btCate on" style="display: flex; align-items: center; justify-content: center;">
                            <img src="/images/icons/category.png" class="btCateLogo">
                            <p style=" font-size: 18px; color: #5D5D5D;">카테고리관리</p>
                        </div>
                    </a>  
                </div>
            </div>
            <div class="serchContainer">
                <form action="/product/cateName" method="post" id="searchForm">
                    <div class="search">
                        <input type="text" placeholder="새 카테고리 이름" id="newCategory" name="cateName">
                    </div>
                    <button type="submit" id="addButton">
                        + 카테고리 추가
                    </button>
                </form>
            </div>
            <div class="tableBox">
                <table>
                    <thead>
                        <tr>
                            <th>카테고리명</th>
                            <th>제품수</th>
                            <th style="text-align: right;">작업</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for(i = 0; i < result.length; i++){ %>
                        <tr id="cateTr<%= i %>">
                            <td><%= result[i].cateName %> <p hidden class="cateId"> <%= result[i].cateId %></p></td>
                            <td>재고충분</td>
                            <td style="text-align: right;">
                                <button type="button" id="modifyCategory">수정</button>
                                <button type="button" id="deleteCategory" onclick="deleteCategory('<%= i %>')" >삭제</button>
                            </td>
                        </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
<script>
    
</script>
</html>