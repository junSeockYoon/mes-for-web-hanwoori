<%- include('../header')  %>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/product.css">
    <script src=""></script>
</head>
    <div class="prodContainer">
        <div class="prodBox">
            <div style="height: 50%;">
                <h3>제품 관리</h3>
                <p>제품과 카테고리를 관리할 수 있습니다</p>
                <div class="prodButton">
                    <a href="/product/product" >
                        <div class="btProd" style="display: flex; align-items: center; justify-content: center;">
                            <img src="/images/icons/mainLogo.png" class="btProdLogo"> 
                            <p>제품목록</p> 
                        </div>
                     </a>
                    <a href="/product/category" >
                        <div class="btCate on" style="display: flex; align-items: center; justify-content: center;">
                            <img src="/images/icons/category.png" class="btCateLogo">
                            <p>카테고리관리</p>
                        </div>
                    </a>  
                </div>
            </div>
            <div class="serchContainer">
                <div class="search">
                    <input type="text" placeholder="새 카테고리 이름">
                </div>
                <div class="serchButton">
                 + 카테고리 추가
                </div>
            </div>
            <div class="tableBox">
                <table>
                    <thead>
                        <tr>
                            <th>카테고리명</th>
                            <th>제품수</th>
                            <th style="text-align: right;">작업</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for(i = 0; i < result.length; i++){ %>
                        <tr>
                            <td><%= result[i].cateName %></td>
                            <td>재고충분</td>
                            <td style="text-align: right;">수정 삭제</td>
                        </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>