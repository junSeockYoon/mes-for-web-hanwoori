<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>로그인 - 재고관리시스템</title>
    <style>
    :root {
        --bg-start: #bfc7d6;
        --bg-end: #bfc7d6;
        --card-bg: #f5f5f5;
        --text-primary: #1f2937;
        --text-secondary: #6b7280;
        --primary: #020617;
        --primary-hover: #111827;
        --border: #e5e7eb;
        --shadow: 0 10px 25px rgba(0,0,0,0.15);
        --radius: 16px;
    }

    * { 
        box-sizing: border-box; 
    }

    body{
        margin:0;
        padding:0;
        font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial;
        color:var(--text-primary);
        background:linear-gradient(135deg,var(--bg-start),var(--bg-end));
        min-height:100vh;
    }

    /* 화면 중앙 */
    .main-container{
        width:100vw;
        min-height:100vh;
        display:flex;
        justify-content:center;
        align-items:center;
    }

    /* 카드 */
    .login-container{
        width:100%;
        max-width:420px;
        background:var(--card-bg);
        border-radius:var(--radius);
        box-shadow:var(--shadow);
        padding:36px;
    }

    /* 헤더 */
    .login-header{
        text-align:center;
        margin-bottom:24px;
    }

    /* 아이콘 */
    .brand{
        display:inline-flex;
        align-items:center;
        justify-content:center;
        width:56px;
        height:56px;
        border-radius:14px;
        background:#2563eb;
        color:white;
        font-size:22px;
        margin-bottom:12px;
    }

    /* 제목 */
    .login-title{
        margin:0 0 8px;
        font-size:26px;
        font-weight:800;
    }

    /* 설명 */
    .login-subtitle{
        margin:0;
        font-size:14px;
        color:var(--text-secondary);
    }

    /* 입력 그룹 */
    .input-group{
        margin-top:18px;
    }

    /* 라벨 */
    .input-label{
        display:block;
        font-size:13px;
        font-weight:600;
        margin-bottom:8px;
    }

    /* 입력창 */
    .input-control{
        width:100%;
        padding:13px 14px;
        border:none;
        border-radius:10px;
        background:#e5e7eb;
        font-size:14px;
    }

    .input-control:focus{
        outline:none;
        box-shadow:0 0 0 3px rgba(59,130,246,0.25);
    }

    /* 버튼 */
    .login-button{
        width:100%;
        margin-top:20px;
        height:46px;
        background:var(--primary);
        color:white;
        border:none;
        border-radius:10px;
        font-weight:700;
        font-size:15px;
        cursor:pointer;
    }

    .login-button:hover{
        background:var(--primary-hover);
    }

    /* 하단 */
    .footer{
        margin-top:20px;
        text-align:center;
        font-size:13px;
        color:var(--text-secondary);
    }

    .footer a{
        color:#2563eb;
        text-decoration:none;
        font-weight:600;
    }

    .footer a:hover{
        text-decoration:underline;
    }

    @media (max-width:480px){
        .login-container{ padding:24px; }
    }
    </style>
    <script>
        function join() {

            let inputId = document.getElementById('inputId').value;
            let pw = document.getElementById('pw').value;
            let pwConfirm = document.getElementById('pwConfirm').value;

            // 비밀번호 확인
            if(pw != pwConfirm) {
                alert("비밀번호가 서로 다릅니다.");
                return;
            }

            let params = {
                email: inputId,
                password: pw
            }

            fetch('/auth/api/join', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(params),
            })
            .then(response => response.json())
            .then(data => {

                if (data.data && data.data.affectedRows > 0) {
                    alert("회원가입되었습니다.");
                    location.href = '/auth/login';
                } else {
                    alert("이미 존재하는 아이디입니다.");
                }

            })
            .catch(error => {
                alert("Error: " + error);
            });

        }
    </script>
</head>

<body>
    <div class="main-container">
        <div class="login-container">

            <div class="login-header">
                <div class="brand">📦</div>
                <h2 class="login-title">회원가입</h2>
                <p class="login-subtitle">
                    새 계정을 만들어 재고 관리 시스템을 시작하세요
                </p>
            </div>

            <div class="input-group">
                <label class="input-label">이름</label>
                <input class="input-control" placeholder="홍길동">
            </div>

            <div class="input-group">
                <label class="input-label">이메일</label>
                <input class="input-control" placeholder="abcd@example.com">
            </div>

            <div class="input-group">
                <label class="input-label">비밀번호</label>
                <input type="password" class="input-control">
            </div>

            <div class="input-group">
                <label class="input-label">비밀번호 확인</label>
                <input type="password" class="input-control">
            </div>

            <button onclick="join()">회원가입</button>

            <div class="footer">
                이미 계정이 있으신가요? <a href="/auth/login">로그인</a>
            </div>

        </div>
    </div>
</body>
</html>